      <geom name="actor_worker_2_neck" type="capsule" size="0.045" fromto="0 0 1.38 0 0 1.44"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_arm_l" type="capsule" size="0.055"
            fromto="0 0.19 1.33 0 0.23 0.92" material="vest_hivis" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_hand_l" type="sphere" size="0.045" pos="0 0.235 0.87"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_arm_r" type="capsule" size="0.055"
            fromto="0 -0.19 1.33 0 -0.23 0.92" material="vest_hivis" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_hand_r" type="sphere" size="0.045" pos="0 -0.235 0.87"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_leg_l" type="capsule" size="0.075"
            fromto="0 0.09 0.88 0 0.10 0.08" material="trousers_navy" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_2_leg_r" type="capsule" size="0.075"
            fromto="0 -0.09 0.88 0 -0.10 0.08" material="trousers_navy" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_2_shoe_l" type="box" size="0.11 0.05 0.03" pos="0.04 0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_shoe_r" type="box" size="0.11 0.05 0.03" pos="0.04 -0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- Facing the container row, back three-quarters to the camera. -->
    <body name="actor_worker_3" pos="8.0 -2.4 0" euler="0 0 -1.5708">
      <geom name="actor_worker_3_torso" type="capsule" size="0.15" fromto="0 0 0.95 0 0 1.35"
