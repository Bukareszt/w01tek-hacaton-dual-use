    <body name="actor_drone_1" pos="7.8 1.1 1.9" euler="0 0 0.5236">
      <geom name="actor_drone_1_body" type="box" size="0.12 0.12 0.04" pos="0 0 0"
            material="drone_dark" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_drone_1_arm_fl" type="capsule" size="0.012" fromto="0 0 0 0.22 0.22 0"
