            fromto="0 -0.09 0.88 0 -0.10 0.08" material="jeans" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_intruder_1_shoe_l" type="box" size="0.11 0.05 0.03" pos="0.04 0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_intruder_1_shoe_r" type="box" size="0.11 0.05 0.03" pos="0.04 -0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- Unauthorized: in front of the gap between the two containers,
         walking away along +x. -->
    <body name="actor_intruder_2" pos="6.0 -4.2 0" euler="0 0 0.0000">
      <geom name="actor_intruder_2_torso" type="capsule" size="0.15" fromto="0 0 0.95 0 0 1.35"
