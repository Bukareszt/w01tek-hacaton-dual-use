      <geom name="actor_worker_3_vest_stripe" type="cylinder" size="0.155 0.02" pos="0 0 1.20"
            material="vest_stripe" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_3_head" type="sphere" size="0.105" pos="0 0 1.53"
