# Personal values live in the gitignored repo-root .env; copy this file
# there and fill it in.

# Hugging Face org hosting the keeper policy repos (the schema-2 deploy
# pairs). Read from the environment; the training tools also read the
# repo-root .env directly (wojtek_rl/paths.py), so exporting it is only
# needed for the ROS launches.
HF_ORGANIZATION=

# Hugging Face token with read access to the keeper repos (they are
# private). Read natively by huggingface_hub; `hf auth login` works too,
# in which case leave this empty.
HF_TOKEN=

# WandB entity (team or user) for training runs. Read natively by wandb;
# empty means the account's default entity. The project name is Hydra
# config (`wandb.project`), not an env value.
WANDB_ENTITY=

# Policy reference override for sim/demo tools: HF repo id, local export
# dir, or a path to policy.npz. Empty means the HF_ORGANIZATION default
# (see wojtek_rl/paths.py).
WOJTEK_POLICY=

# VLM action server for the navigation demo (`run.sh room`): base URL of
# a vLLM-compatible endpoint, e.g. http://HOST:8090. Empty selects the
# built-in default backend.
VLM_URL=
# API key for that endpoint, if it has one ("EMPTY" is the vLLM default).
VLLM_API_KEY=

# --- experiments/wojtek_arm_vlm_agent (SO-101 arm + wrist camera + VLM agent) ---
# Robot host (Raspberry Pi) running camera_stream.py and arm_follower.py.
WOJTEK_ARM_RPI_HOST=
# Inference host (GPU) running tracker.py and commander.py.
WOJTEK_ARM_DGX_HOST=
# Optional laptop running stream_relay.py to watch the video (empty = no push).
WOJTEK_ARM_VIEWER_HOST=
# Camera device on the robot host; a /dev/v4l/by-id/... path survives replugs.
WOJTEK_ARM_CAMERA=/dev/video0
# SO-101 serial adapter on the robot host; prefer a /dev/serial/by-id/... path.
WOJTEK_ARM_SERIAL=/dev/ttyACM0
# Ollama endpoint on the inference host and the vision model with tool calling.
WOJTEK_ARM_OLLAMA_URL=http://127.0.0.1:11434
WOJTEK_ARM_VLM_MODEL=qwen3-vl:30b-a3b-instruct
# Joint direction signs learned with `arm_follower.py --execute --probe` (pan tilt lift).
WOJTEK_ARM_SIGNS="1 1 1"
