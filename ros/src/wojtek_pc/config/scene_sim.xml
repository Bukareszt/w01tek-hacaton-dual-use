<!--
  The simulation's world: a harbour dock built around the training scene.

  scene_mjx.xml is an empty checkerboard floor, which is what a walking
  policy needs and nothing else. The deck panel runs an object detector on
  the robot's camera picture, and on an empty floor it has nothing to find,
  so this file adds a handful of props around the spawn: a ball, a fire
  hydrant, a traffic light, a stop sign, a clock, and a person standing off
  in the distance. Each one was chosen by rendering it and asking the panel's
  own YOLOX-nano what it saw; the ones that survived are named confidently
  from one to three metres away (the person from about five).

  Around those props the world is a harbour dock: a concrete quay with the
  water on the +y side, a kerb and mooring bollards along that edge, a row of
  shipping containers on the -y side, a few wooden crates, a moored boat and a
  gantry crane in the distance. The props keep the exact positions they had on
  the bare floor, because other code refers to them by those coordinates, so
  the dock is laid out around them: nothing was moved, renamed or restyled to
  make room for it.

  This is the file BOTH halves of the simulation load -- the physics plugin
  inside ros2_control and the camera node that draws the picture -- so the
  props are solid: the robot bumps into them instead of walking through. They
  are static bodies with no joints, so the generalized position the plugin
  publishes has exactly the same layout it had without them, and nothing
  about the robot, the policy or the training model changes. The training
  scene is included, never edited: scene_mjx.xml and wojtek_mjx.xml are
  generated by ./training/run.sh build.

  A prop's own +x points at its face, so a prop is turned toward the spawn by
  giving its body a yaw of atan2(-y, -x). The two signs wear a picture from
  props/ (see props/make_textures.py); everything else is plain colour, which
  is all the detector needs.

  The dock is scenery, so it is cheap. Everything the robot could walk off or
  bump into -- the kerb, the bollards, the containers, the crates -- is one
  solid box or cylinder; the quay surface, the water, the boat, the crane and
  the ropes are visual only, so the contact list stays about as short as it
  was. The quay surface in particular is a 6 mm slab laid 4 mm into the floor:
  it draws over the checkerboard, but the feet still stand on the training
  plane at z=0, which is the surface the policy was trained on.

  Heights are not free. The camera sits about 0.21 m off the floor and looks
  15 degrees down, so at two metres the top of the picture is only 0.75 m up
  and anything taller is cut off. Everything here is short on purpose, which
  is also why the person stands far enough back to fit in the frame.
-->
<mujoco model="wojtek_sim_scene">
  <include file="scene_mjx.xml"/>

  <compiler texturedir="props"/>

  <!-- A brighter, flatter light than the training scene's. The props are
       small and far from the lens; under the darker default they came out as
       silhouettes and the detector lost several of them. -->
  <visual>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.55 0.55 0.55" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture type="2d" name="stop_face" file="stop_sign.png"/>
    <material name="stop_face" texture="stop_face"/>
    <texture type="2d" name="clock_face" file="clock.png"/>
    <material name="clock_face" texture="clock_face"/>
    <!-- A ball is a ball because of the panels on it, not the colour. -->
    <texture type="2d" name="ball_skin" builtin="checker" mark="cross"
             rgb1="1 1 1" rgb2="0.9 0.35 0.05" markrgb="0.1 0.1 0.1"
             width="128" height="128"/>
    <!-- texuniform is what wraps the pattern around a sphere; without it the
         panels come out as one flat patch and the ball stops being a ball. -->
    <material name="ball_skin" texture="ball_skin" texuniform="true" texrepeat="2 2"/>
    <material name="prop_post" rgba="0.55 0.56 0.58 1"/>
    <material name="prop_dark" rgba="0.12 0.12 0.14 1"/>
    <material name="prop_hydrant" rgba="0.85 0.12 0.10 1"/>
    <!-- emission so the lamps read as lit rather than as painted discs -->
    <material name="lamp_red" rgba="0.95 0.15 0.1 1" emission="0.7"/>
    <material name="lamp_amber" rgba="0.98 0.7 0.1 1" emission="0.7"/>
    <material name="lamp_green" rgba="0.15 0.9 0.3 1" emission="0.7"/>
    <material name="prop_skin" rgba="0.85 0.68 0.55 1"/>
    <material name="prop_hair" rgba="0.22 0.16 0.12 1"/>
    <material name="prop_shirt" rgba="0.30 0.42 0.72 1"/>
    <material name="prop_trousers" rgba="0.2 0.2 0.25 1"/>
    <!-- The dock's four pictures (props/make_textures.py writes them next to
         the sign faces). texuniform keeps a pattern the same size on every
         shape it lands on: one tile is 2/texrepeat metres across, so
         texrepeat="2 2" is a one-metre tile. container_wall.png is grey and
         each container tints it with its own rgba. -->
    <texture type="2d" name="quay" file="quay_concrete.png"/>
    <material name="quay" texture="quay" texuniform="true" texrepeat="2 2"/>
    <texture type="2d" name="water" file="water.png"/>
    <material name="water" texture="water" texuniform="true" texrepeat="0.5 0.5"
              specular="0.5" shininess="0.5" reflectance="0"/>
    <texture type="2d" name="crate" file="crate.png"/>
    <material name="crate" texture="crate" texuniform="true" texrepeat="4 4"/>
    <texture type="2d" name="container_wall" file="container_wall.png"/>
    <material name="container_red" texture="container_wall" texuniform="true"
              texrepeat="2 2" rgba="0.62 0.19 0.15 1"/>
    <material name="container_blue" texture="container_wall" texuniform="true"
              texrepeat="2 2" rgba="0.17 0.31 0.53 1"/>
    <material name="container_green" texture="container_wall" texuniform="true"
              texrepeat="2 2" rgba="0.16 0.40 0.27 1"/>
    <!-- plain colours for the ironwork and the distant silhouettes -->
    <material name="quay_dark" rgba="0.26 0.26 0.28 1"/>
    <material name="bollard" rgba="0.13 0.14 0.15 1"/>
    <material name="rope" rgba="0.72 0.60 0.40 1"/>
    <material name="hull" rgba="0.45 0.11 0.10 1"/>
    <material name="cabin" rgba="0.85 0.85 0.82 1"/>
    <material name="crane_steel" rgba="0.85 0.68 0.10 1"/>
  </asset>

  <worldbody>
    <!-- One sun so the props have a lit side and a shaded one. No shadows:
         they cost render time and the detector does not need them. -->
    <light name="prop_sun" directional="true" castshadow="false"
           pos="2 2 5" dir="-0.35 -0.35 -1" diffuse="0.8 0.78 0.72"/>

    <!-- Group 2 is the visible group; contype/conaffinity on the load-bearing
         shape of each prop is what makes it solid. The trimmings (lamps,
         faces, hands) are visual only, so the contact list stays short. -->

    <body name="prop_ball" pos="1.60 0.58 0">
      <geom name="prop_ball_geom" type="sphere" size="0.11" pos="0 0 0.11"
            material="ball_skin" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="prop_hydrant" pos="2.10 -1.30 0">
      <geom name="prop_hydrant_body" type="cylinder" size="0.115 0.23" pos="0 0 0.23"
            material="prop_hydrant" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_hydrant_dome" type="sphere" size="0.115" pos="0 0 0.46"
            material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_bonnet" type="cylinder" size="0.06 0.05" pos="0 0 0.57"
            material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_cap_l" type="cylinder" size="0.06 0.05" pos="0 0.14 0.30"
            euler="1.5708 0 0" material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_cap_r" type="cylinder" size="0.06 0.05" pos="0 -0.14 0.30"
            euler="1.5708 0 0" material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_nose" type="cylinder" size="0.05 0.05" pos="0.14 0 0.30"
            euler="0 1.5708 0" material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_hydrant_flange" type="cylinder" size="0.15 0.025" pos="0 0 0.025"
            material="prop_hydrant" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="prop_traffic_light" pos="0.90 -3.10 0" euler="0 0 1.8534">
      <geom name="prop_traffic_post" type="cylinder" size="0.025 0.14" pos="0 0 0.14"
            material="prop_post" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_traffic_case" type="box" size="0.055 0.09 0.20" pos="0 0 0.46"
            material="prop_dark" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_traffic_red" type="cylinder" size="0.055 0.008" pos="0.058 0 0.59"
            euler="0 1.5708 0" material="lamp_red" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_traffic_amber" type="cylinder" size="0.055 0.008" pos="0.058 0 0.46"
            euler="0 1.5708 0" material="lamp_amber" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_traffic_green" type="cylinder" size="0.055 0.008" pos="0.058 0 0.33"
            euler="0 1.5708 0" material="lamp_green" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="prop_stop_sign" pos="1.72 2.46 0" euler="0 0 -2.1810">
      <geom name="prop_stop_post" type="cylinder" size="0.022 0.10" pos="0 0 0.10"
            material="prop_post" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_stop_plate" type="box" size="0.018 0.31 0.31" pos="0 0 0.40"
            material="stop_face" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="prop_clock" pos="-2.35 0.86 0" euler="0 0 -0.3508">
      <geom name="prop_clock_post" type="cylinder" size="0.022 0.10" pos="0 0 0.10"
            material="prop_post" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_clock_plate" type="box" size="0.018 0.25 0.25" pos="0 0 0.38"
            material="clock_face" contype="1" conaffinity="15" group="2"/>
    </body>

    <!-- Far enough back that the whole figure fits in the frame; a person
         two metres away is legs and nothing else, and reads as no one. -->
    <body name="prop_person" pos="6.48 0.57 0" euler="0 0 -3.0539">
      <geom name="prop_person_torso" type="capsule" size="0.15" fromto="0 0 0.95 0 0 1.35"
            material="prop_shirt" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_person_head" type="sphere" size="0.105" pos="0 0 1.53"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_hair" type="sphere" size="0.098" pos="-0.02 0 1.57"
            material="prop_hair" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_neck" type="capsule" size="0.045" fromto="0 0 1.38 0 0 1.44"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_arm_l" type="capsule" size="0.055" fromto="0 0.19 1.33 0 0.23 0.92"
            material="prop_shirt" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_arm_r" type="capsule" size="0.055" fromto="0 -0.19 1.33 0 -0.23 0.92"
            material="prop_shirt" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_hand_l" type="sphere" size="0.045" pos="0 0.235 0.87"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_hand_r" type="sphere" size="0.045" pos="0 -0.235 0.87"
            material="prop_skin" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_leg_l" type="capsule" size="0.075" fromto="0 0.09 0.88 0 0.10 0.08"
            material="prop_trousers" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_person_leg_r" type="capsule" size="0.075" fromto="0 -0.09 0.88 0 -0.10 0.08"
            material="prop_trousers" contype="1" conaffinity="15" group="2"/>
      <geom name="prop_person_shoe_l" type="box" size="0.11 0.05 0.03" pos="0.04 0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
      <geom name="prop_person_shoe_r" type="box" size="0.11 0.05 0.03" pos="0.04 -0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- The quay surface. Visual only and 6 mm thin, laid 4 mm into the floor
         so its top face is 2 mm up: it hides the checkerboard, and the feet
         still land on the training plane. It stops at y=4, where the water
         starts, and runs to the horizon the other way (x -20..30, y -25..4),
         so the checkerboard never shows at the edge of a picture. -->
    <body name="dock_quay" pos="5 -10.5 0">
      <geom name="dock_quay_slab" type="box" size="25 14.5 0.006" pos="0 0 -0.004"
            material="quay" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- The harbour basin on the +y side. High tide: the water sits level
         with the quay, the same 2 mm sheet as the slab, because the training
         floor is an infinite plane at z=0 and anything drawn below it is
         hidden. Visual only; the robot never gets there, the kerb stops it
         first. The wall is the quay's coping, a dark strip along the edge
         that separates concrete from water in the picture. -->
    <body name="dock_water" pos="5 29 0">
      <geom name="dock_water_surface" type="box" size="40 25 0.006" pos="0 0 -0.004"
            material="water" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="dock_wall" pos="5 4.0 0">
      <geom name="dock_wall_face" type="box" size="25 0.06 0.04" pos="0 0 0.04"
            material="quay_dark" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- The kerb along the water's edge: solid, so the robot bumps into it
         instead of walking off, and 0.12 m tall: high enough for the depth
         camera and Nav2's costmap to see the edge as an obstacle, low enough
         for the lens at 0.21 m to see the water beyond it. It keeps 0.98 m
         clear of the stop sign's plate, which reaches y=2.77. -->
    <body name="dock_kerb" pos="5 3.85 0">
      <geom name="dock_kerb_rail" type="box" size="25 0.10 0.06" pos="0 0 0.06"
            material="quay_dark" contype="1" conaffinity="15" group="2"/>
    </body>

    <!-- Mooring bollards every four metres along the edge, just inside the
         kerb. The post is solid; the cap and the rope drooping over the edge
         into the water are trimmings. -->
    <body name="dock_bollard_1" pos="-3 3.6 0">
      <geom name="dock_bollard_1_post" type="cylinder" size="0.09 0.22" pos="0 0 0.22"
            material="bollard" contype="1" conaffinity="15" group="2"/>
      <geom name="dock_bollard_1_cap" type="sphere" size="0.105" pos="0 0 0.44"
            material="bollard" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_bollard_1_rope" type="capsule" size="0.022"
            fromto="0 0.06 0.42 0 0.78 0.02"
            material="rope" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="dock_bollard_2" pos="1 3.6 0">
      <geom name="dock_bollard_2_post" type="cylinder" size="0.09 0.22" pos="0 0 0.22"
            material="bollard" contype="1" conaffinity="15" group="2"/>
      <geom name="dock_bollard_2_cap" type="sphere" size="0.105" pos="0 0 0.44"
            material="bollard" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_bollard_2_rope" type="capsule" size="0.022"
            fromto="0 0.06 0.42 0 0.78 0.02"
            material="rope" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="dock_bollard_3" pos="5 3.6 0">
      <geom name="dock_bollard_3_post" type="cylinder" size="0.09 0.22" pos="0 0 0.22"
            material="bollard" contype="1" conaffinity="15" group="2"/>
      <geom name="dock_bollard_3_cap" type="sphere" size="0.105" pos="0 0 0.44"
            material="bollard" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_bollard_3_rope" type="capsule" size="0.022"
            fromto="0 0.06 0.42 0 0.78 0.02"
            material="rope" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="dock_bollard_4" pos="9 3.6 0">
      <geom name="dock_bollard_4_post" type="cylinder" size="0.09 0.22" pos="0 0 0.22"
            material="bollard" contype="1" conaffinity="15" group="2"/>
      <geom name="dock_bollard_4_cap" type="sphere" size="0.105" pos="0 0 0.44"
            material="bollard" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_bollard_4_rope" type="capsule" size="0.022"
            fromto="0 0.06 0.42 0 0.78 0.02"
            material="rope" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- A row of shipping containers on the -y side, away from the water.
         y=-6.0 keeps their near face 1.7 m clear of the traffic light at
         (0.90, -3.10) and leaves the corridor from the spawn past the hydrant
         wide open. The blue one is a few degrees off square, which is what
         stops the row from reading as one long wall. The green one is stacked
         on the red one. -->
    <body name="dock_container_1" pos="2 -6.0 0">
      <geom name="dock_container_1_box" type="box" size="3 1.2 1.3" pos="0 0 1.3"
            material="container_red" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="dock_container_2" pos="8.65 -6.0 0" euler="0 0 0.1047">
      <geom name="dock_container_2_box" type="box" size="3 1.2 1.3" pos="0 0 1.3"
            material="container_blue" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="dock_container_3" pos="2 -6.0 0">
      <geom name="dock_container_3_box" type="box" size="3 1.2 1.3" pos="0 0 3.9"
            material="container_green" contype="1" conaffinity="15" group="2"/>
    </body>

    <!-- Wooden crates: two stacked where the robot can walk round them, one
         on its own further back. Both spots are more than 1.2 m from every
         prop and off the straight lines from the spawn to the ball and to
         the hydrant. -->
    <body name="dock_crate_1" pos="4.2 1.6 0">
      <geom name="dock_crate_1_box" type="box" size="0.3 0.3 0.3" pos="0 0 0.3"
            material="crate" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="dock_crate_2" pos="4.2 1.6 0">
      <geom name="dock_crate_2_box" type="box" size="0.3 0.3 0.3" pos="0 0 0.9"
            material="crate" contype="1" conaffinity="15" group="2"/>
    </body>

    <body name="dock_crate_3" pos="-1.6 -2.2 0">
      <geom name="dock_crate_3_box" type="box" size="0.3 0.3 0.3" pos="0 0 0.3"
            material="crate" contype="1" conaffinity="15" group="2"/>
    </body>

    <!-- A fishing boat moored alongside, its hull sitting on the water
         sheet, a metre and a half out from the edge. Visual only. -->
    <body name="dock_boat" pos="4 6.2 0">
      <geom name="dock_boat_hull" type="box" size="2.25 0.8 0.35" pos="0 0 0.35"
            material="hull" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_boat_cabin" type="box" size="0.55 0.6 0.4" pos="-0.7 0 1.1"
            material="cabin" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_boat_mast" type="cylinder" size="0.04 1.1" pos="0.7 0 1.8"
            material="bollard" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- A gantry crane on the skyline, straddling the far end of the quay.
         Three boxes at x=18: tall enough to read as a harbour from the deck
         panel's picture, far enough away to cost nothing. Visual only. -->
    <body name="dock_crane" pos="18 0 0">
      <geom name="dock_crane_leg_l" type="box" size="0.15 0.15 4.5" pos="0 3 4.5"
            material="crane_steel" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_crane_leg_r" type="box" size="0.15 0.15 4.5" pos="0 -3 4.5"
            material="crane_steel" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_crane_beam" type="box" size="0.3 3.3 0.3" pos="0 0 9.3"
            material="crane_steel" contype="0" conaffinity="0" group="2"/>
    </body>
  </worldbody>
</mujoco>
