      <geom name="actor_worker_3_helmet" type="sphere" size="0.115" pos="0 0 1.56"
            material="helmet_white" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_3_helmet_brim" type="cylinder" size="0.075 0.008" pos="0.105 0 1.545"
