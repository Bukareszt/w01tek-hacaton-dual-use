      <geom name="actor_intruder_1_hand_r" type="sphere" size="0.045" pos="0 -0.235 0.87"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_intruder_1_leg_l" type="capsule" size="0.075"
