      <geom name="actor_worker_3_hand_l" type="sphere" size="0.045" pos="0 0.235 0.87"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_3_arm_r" type="capsule" size="0.055"
            fromto="0 -0.19 1.33 0 -0.23 0.92" material="vest_hivis" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_3_hand_r" type="sphere" size="0.045" pos="0 -0.235 0.87"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_3_leg_l" type="capsule" size="0.075"
            fromto="0 0.09 0.88 0 0.10 0.08" material="trousers_navy" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_3_leg_r" type="capsule" size="0.075"
            fromto="0 -0.09 0.88 0 -0.10 0.08" material="trousers_navy" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_3_shoe_l" type="box" size="0.11 0.05 0.03" pos="0.04 0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_3_shoe_r" type="box" size="0.11 0.05 0.03" pos="0.04 -0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- Unauthorized: standing among the bollards at the water's edge,
         facing the spawn. Bare head and no vest are the whole tell. -->
    <body name="actor_intruder_1" pos="9.5 2.6 0" euler="0 0 -2.8749">
      <geom name="actor_intruder_1_torso" type="capsule" size="0.15" fromto="0 0 0.95 0 0 1.35"
            material="hoodie_black" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_intruder_1_head" type="sphere" size="0.105" pos="0 0 1.53"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_intruder_1_hair" type="sphere" size="0.098" pos="-0.02 0 1.57"
            material="hair" contype="0" conaffinity="0" group="2"/>
