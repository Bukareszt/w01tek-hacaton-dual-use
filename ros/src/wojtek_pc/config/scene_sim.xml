<!--
  The simulation's world: a harbour dock built around the training scene.

  scene_mjx.xml is an empty checkerboard floor, which is what a walking
  policy needs and nothing else. The deck panel runs an object detector on
  the robot's camera picture, and on an empty floor it has nothing to find,
  so this file populates the quay with a cast for the detector to pick out:
  three dock workers in hi-vis vests and hard hats, two people in plain
  clothes wearing neither, and three quadcopters hovering overhead. The
  street props that used to stand here -- a ball, a hydrant, a traffic
  light, a stop sign and a clock -- are gone; a harbour has none of them,
  and what the panel has to tell apart now is who belongs on the quay.
  The uniform is the whole point: a helmet and a vest mark a worker, their
  absence marks someone who should not be here, so the figures differ by
  what they wear and not by how they are built.

  Every actor's position is referenced from outside this file: the scene
  tests assert the coordinates and the RAI places file names them. Moving
  an actor means changing both.

  Around the cast the world is a harbour dock: a concrete quay with the
  water on the +y side, a kerb and mooring bollards along that edge, a row of
  shipping containers on the -y side, a few wooden crates, a moored boat and a
  gantry crane in the distance. The dock itself did not move to make room for
  the cast: the actors were placed into the quay as it already stood.

  This is the file BOTH halves of the simulation load -- the physics plugin
  inside ros2_control and the camera node that draws the picture -- so the
  people are solid: the robot bumps into them instead of walking through.
  The drones are visual only, because the robot cannot reach them. Everything
  is a static body with no joints, so the generalized position the plugin
  publishes has exactly the same layout it had without them, and nothing
  about the robot, the policy or the training model changes. The training
  scene is included, never edited: scene_mjx.xml and wojtek_mjx.xml are
  generated by ./training/run.sh build.

  A body's own +x points at its face, so a figure is turned toward the spawn
  by giving its body a yaw of atan2(-y, -x). The dock's surfaces wear a
  picture from props/ (see props/make_textures.py); the cast is plain colour,
  which is all the detector needs.

  The dock is scenery, so it is cheap. Everything the robot could walk off or
  bump into -- the kerb, the bollards, the containers, the crates -- is one
  solid box or cylinder; the quay surface, the water, the boat, the crane and
  the ropes are visual only, so the contact list stays about as short as it
  was. The quay surface in particular is a 6 mm slab laid 4 mm into the floor:
  it draws over the checkerboard, but the feet still stand on the training
  plane at z=0, which is the surface the policy was trained on.

  Heights are not free. The camera sits about 0.21 m off the floor and looks
  15 degrees down, so the top of the picture at distance d metres is only
  0.21 + 0.263*d up and anything taller is cut off. A 1.7 m figure therefore
  needs 5.7 m of clearance and a drone at height h needs (h - 0.21) / 0.263:
  that, not composition, is what fixes how far out the cast stands.
-->
<mujoco model="wojtek_sim_scene">
  <include file="scene_mjx.xml"/>

  <compiler texturedir="props"/>

  <!-- A brighter, flatter light than the training scene's. The cast stands
       far from the lens; under the darker default the figures came out as
       silhouettes and the detector lost several of them. -->
  <visual>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.55 0.55 0.55" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <!-- prop_dark is the one survivor of the street props: it paints the
         cast's shoes. -->
    <material name="prop_dark" rgba="0.12 0.12 0.14 1"/>
    <!-- The dock worker's uniform. The vest is what the detector and a human
         reviewer both read first, so it is the loudest colour in the scene;
         the stripe is the reflective band around the chest. -->
    <material name="vest_hivis" rgba="1.0 0.45 0.05 1"/>
    <material name="vest_stripe" rgba="0.85 0.85 0.85 1"/>
    <material name="helmet_white" rgba="0.95 0.95 0.92 1"/>
    <material name="helmet_yellow" rgba="0.98 0.85 0.1 1"/>
    <material name="trousers_navy" rgba="0.12 0.15 0.3 1"/>
    <!-- Plain clothes: no vest, no helmet, nothing that says "on shift". -->
    <material name="hoodie_black" rgba="0.08 0.08 0.09 1"/>
    <material name="hoodie_grey" rgba="0.45 0.45 0.47 1"/>
    <material name="jeans" rgba="0.25 0.3 0.45 1"/>
    <material name="skin" rgba="0.85 0.68 0.55 1"/>
    <material name="hair" rgba="0.22 0.16 0.12 1"/>
    <!-- The quadcopters. The rotors are translucent so they read as spinning
         discs rather than solid plates, and the nose LED is emissive. -->
    <material name="drone_dark" rgba="0.15 0.15 0.17 1"/>
    <material name="drone_rotor" rgba="0.3 0.3 0.32 0.9"/>
    <material name="drone_led" rgba="1 0.1 0.1 1" emission="0.8"/>
    <!-- The dock's four pictures (props/make_textures.py writes them next to
         the sign faces). texuniform keeps a pattern the same size on every
         shape it lands on: one tile is 2/texrepeat metres across, so
         texrepeat="2 2" is a one-metre tile. container_wall.png is grey and
         each container tints it with its own rgba. -->
    <texture type="2d" name="quay" file="quay_concrete.png"/>
    <material name="quay" texture="quay" texuniform="true" texrepeat="2 2"/>
    <texture type="2d" name="water" file="water.png"/>
    <material name="water" texture="water" texuniform="true" texrepeat="0.5 0.5"
              specular="0.5" shininess="0.5" reflectance="0"/>
    <texture type="2d" name="crate" file="crate.png"/>
    <material name="crate" texture="crate" texuniform="true" texrepeat="4 4"/>
    <texture type="2d" name="container_wall" file="container_wall.png"/>
    <material name="container_red" texture="container_wall" texuniform="true"
              texrepeat="2 2" rgba="0.62 0.19 0.15 1"/>
    <material name="container_blue" texture="container_wall" texuniform="true"
              texrepeat="2 2" rgba="0.17 0.31 0.53 1"/>
    <material name="container_green" texture="container_wall" texuniform="true"
              texrepeat="2 2" rgba="0.16 0.40 0.27 1"/>
    <!-- plain colours for the ironwork and the distant silhouettes -->
    <material name="quay_dark" rgba="0.26 0.26 0.28 1"/>
    <material name="bollard" rgba="0.13 0.14 0.15 1"/>
    <material name="rope" rgba="0.72 0.60 0.40 1"/>
    <material name="hull" rgba="0.45 0.11 0.10 1"/>
    <material name="cabin" rgba="0.85 0.85 0.82 1"/>
    <material name="crane_steel" rgba="0.85 0.68 0.10 1"/>
  </asset>

  <worldbody>
    <!-- One sun so the cast has a lit side and a shaded one. No shadows:
         they cost render time and the detector does not need them. -->
    <light name="prop_sun" directional="true" castshadow="false"
           pos="2 2 5" dir="-0.35 -0.35 -1" diffuse="0.8 0.78 0.72"/>

    <!-- Group 2 is the visible group; contype/conaffinity on the torso and the
         legs of each figure is what makes it solid, the same two shapes the
         street props used. The trimmings -- head, helmet, arms, hands, shoes,
         the vest's stripe -- are visual only, and so is every drone, so the
         contact list stays about as short as it was.

         THE CAST. Three dock workers in the same uniform (hi-vis vest with a
         reflective stripe, navy trousers, hard hat) and two people in plain
         clothes with neither vest nor helmet. Every figure is built from the
         same capsules: a torso, a sphere head, capsule arms and legs, box
         shoes. Distances are set by the lens, not by taste: the top of the
         picture is 0.21 + 0.263*d metres up, so a 1.7 m figure fits whole
         only from 5.7 m out. -->
    <!-- Facing the spawn, roughly where the old lone figure stood. -->
    <body name="actor_worker_1" pos="6.5 0.6 0" euler="0 0 -3.0495">
      <geom name="actor_worker_1_torso" type="capsule" size="0.15" fromto="0 0 0.95 0 0 1.35"
            material="vest_hivis" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_1_vest_stripe" type="cylinder" size="0.155 0.02" pos="0 0 1.20"
            material="vest_stripe" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_head" type="sphere" size="0.105" pos="0 0 1.53"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_helmet" type="sphere" size="0.115" pos="0 0 1.56"
            material="helmet_white" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_helmet_brim" type="cylinder" size="0.075 0.008" pos="0.105 0 1.545"
            material="helmet_white" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_neck" type="capsule" size="0.045" fromto="0 0 1.38 0 0 1.44"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_arm_l" type="capsule" size="0.055"
            fromto="0 0.19 1.33 0 0.23 0.92" material="vest_hivis" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_hand_l" type="sphere" size="0.045" pos="0 0.235 0.87"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_arm_r" type="capsule" size="0.055"
            fromto="0 -0.19 1.33 0 -0.23 0.92" material="vest_hivis" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_hand_r" type="sphere" size="0.045" pos="0 -0.235 0.87"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_leg_l" type="capsule" size="0.075"
            fromto="0 0.09 0.88 0 0.10 0.08" material="trousers_navy" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_1_leg_r" type="capsule" size="0.075"
            fromto="0 -0.09 0.88 0 -0.10 0.08" material="trousers_navy" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_1_shoe_l" type="box" size="0.11 0.05 0.03" pos="0.04 0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_1_shoe_r" type="box" size="0.11 0.05 0.03" pos="0.04 -0.10 0.03"
            material="prop_dark" contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- Turned toward the water: a side view, so the detector sees a
         profile as well as two front-on figures. -->
    <body name="actor_worker_2" pos="6.2 3.5 0" euler="0 0 1.5708">
      <geom name="actor_worker_2_torso" type="capsule" size="0.15" fromto="0 0 0.95 0 0 1.35"
            material="vest_hivis" contype="1" conaffinity="15" group="2"/>
      <geom name="actor_worker_2_vest_stripe" type="cylinder" size="0.155 0.02" pos="0 0 1.20"
            material="vest_stripe" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_head" type="sphere" size="0.105" pos="0 0 1.53"
            material="skin" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_helmet" type="sphere" size="0.115" pos="0 0 1.56"
            material="helmet_yellow" contype="0" conaffinity="0" group="2"/>
      <geom name="actor_worker_2_helmet_brim" type="cylinder" size="0.075 0.008" pos="0.105 0 1.545"
